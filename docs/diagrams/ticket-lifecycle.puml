@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial

title Persisted Plan Delivery — One Branch, One PR, One Merge

start
:Persist Plan Issue + child Ticket Issues;
:Create Plan branch;

while (Unfinished Tickets remain?) is (yes)
  :Select dependency-ready Ticket;
  while (Ticket acceptance incomplete?) is (yes)
    :Execute dependency-ready Slice;
    :Record Slice validation evidence;
  endwhile (no)
  :Record Ticket acceptance evidence;
endwhile (no)

repeat
  :Run Plan integration + Test Quality Gate;
  if (Gate satisfied?) then (no)
    :Return to affected Ticket / Slice;
    :Resolve failed or missing evidence;
  endif
repeat while (Gate satisfied?) is (no)
->yes;

:Create / Update Plan PR;
:Merge Plan PR once;
:Delete source branch + update default branch;
:Close Plan + child Tickets;
stop
@enduml
