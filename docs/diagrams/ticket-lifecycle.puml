@startuml
!theme plain
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial

title Plan / Ticket Lifecycle — One Branch, One PR, One Merge

state "Plan Issue persisted\nChild Ticket Issues persisted" as persisted
state "Plan branch active" as branch
state "Select dependency-ready Ticket" as select
state "Execute dependency-ready Slices" as slices
state "Ticket acceptance + evidence complete" as accepted
state "More Tickets?" as more
state "Plan integration + Test Quality Gate" as gate
state "Create / Update Plan PR" as publish
state "Merge Plan PR once" as merge
state "Delete branch + Update main" as cleanup
state "Close Plan + Tickets" as done

[*] --> persisted
persisted --> branch
branch --> select
select --> slices
slices --> accepted
accepted --> more
more --> select : yes
more --> gate : no
gate --> slices : gap / failed evidence
gate --> publish : PASS
publish --> merge
merge --> cleanup
cleanup --> done
done --> [*]
@enduml
