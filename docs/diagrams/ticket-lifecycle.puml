@startuml
title Plan / Ticket Lifecycle

state "Plan + Ticket Issues persisted" as persisted
state "Plan branch active" as branch
state "Select dependency-ready Ticket" as select
state "Execute Ticket Slices" as slices
state "Ticket acceptance passes" as accepted
state "More Tickets?" as more
state "Publish Plan PR" as publish
state "Merge Plan PR once" as merge
state "Close Plan + Tickets" as done

persisted --> branch
branch --> select
select --> slices
slices --> accepted
accepted --> more
more --> select : yes
more --> publish : no
publish --> merge
merge --> done
@enduml
