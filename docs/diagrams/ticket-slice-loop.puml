@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial

title Ticket Execution — Slice Implementation and Verification Loop

start

repeat
  :Select dependency-ready Slice;
  :Confirm Slice contract\nGoal / scope / dependencies / acceptance / tests;

  repeat
    :Make minimum implementation change;
    :Run focused verification;

    if (Focused checks pass?) then (yes)
      :Run mandatory risk dimensions;
    else (no)
      :Classify focused-test failure;
    endif

    if (Test Quality Gate satisfied?) then (no)
      :Classify failed or missing evidence;

      if (External blocker?) then (yes)
        :Record cause + exact resume point;
        stop
      else (no)
        if (Requirement / design conflict?) then (yes)
          :Re-plan Slice / Ticket\nUpdate boundaries + acceptance;
        else (no)
          :Fix in-scope implementation or test defect;
        endif
      endif
    endif

  repeat while (Test Quality Gate satisfied?) is (no)
  ->yes;

  :Record executed Slice evidence;

repeat while (More dependency-ready Slices?) is (yes)
->no;

:Confirm Ticket acceptance complete;
stop
@enduml
