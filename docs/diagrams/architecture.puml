@startuml
title Codex Development Workflow

state Requirement
state "Understand repo" as Understand
state Plan
state "Record Plan + Tickets + Slices" as Issues
state "Create Plan branch" as Branch
state "Implement all Plan Tickets" as Implement
state Test
state "Documentation impact check" as Docs
state "Redaction scan if applicable" as Redact
state Commit
state "Push branch" as Push
state "Create / Update PR" as PR
state "Merge Plan PR once" as Merge
state "Delete branch / Update main" as Cleanup
state "Close Plan + Tickets" as Close
state "Update State / Docs" as State

Requirement --> Understand
Understand --> Plan
Plan --> Issues
Issues --> Branch
Branch --> Implement
Implement --> Test
Test --> Docs
Docs --> Redact
Redact --> Commit
Commit --> Push
Push --> PR
PR --> Merge
Merge --> Cleanup
Cleanup --> Close
Close --> State
@enduml
