@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial

title Codex Development Workflow — Full Delivery Control Flow

start
:Receive requirement;
:plan-workflow\nUnderstand, design, decompose;

if (Persisted Plan required?) then (yes)
  :Persist Plan Issue + child Ticket Issues;
else (no)
  :Keep the plan inline;
endif

:Create or resume Plan branch;

repeat
  :develop-workflow\nImplement dependency-ready work;
  :verify-workflow\nRun Test Quality Gate;
repeat while (Test Quality Gate satisfied?) is (no)
->yes;

:repo-documentation\nRun documentation impact check;
:Run staged redaction gate when applicable;
:publish-workflow\nCommit, push, create/update PR;
:integrate-workflow\nMerge once and clean up;
:Close persisted Plan + Tickets when applicable;
:Refresh verified State / Docs;
:Evaluate workflow;

if (Reusable low-risk improvement?) then (yes)
  :Start one separate follow-up change\nthrough the same workflow;
else (no)
  :Finish;
endif

stop
@enduml
