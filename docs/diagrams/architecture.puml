@startuml
!theme plain
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam ArrowColor #4A5568
skinparam state {
  BackgroundColor #F8F9FA
  BorderColor #4A5568
  FontColor #1A202C
}

title Codex Development Workflow - Main-Agent-Led Staged Process

state "Requirement" as requirement
state "Classify task\nTiny / Normal / Complex" as classify
state "Understand\nCurrent Repo" as context
state "Plan\narchitecture + scope" as plan
state "Define one Slice\n[plan-to-ticket]\ngoal • scope • dependencies\nacceptance • validation" as slice
state "Persist plan / tickets\n[plan-to-ticket]\nGitHub Issues authoritative" as persist #EAF2F8
state "Delegation Gate\nIndependent + bounded?\n(optional)" as delegation #FFF4CC
state "Explorer\n[explorer]\nread-only evidence" as explorer
state "Worker A / B\n[worker]\nisolated Slice execution + validation" as workers
state "Worker result summary\nmain agent receives findings • changes • tests • risks" as worker_result

state "Slice Execution / Test Loop\n[main agent]" as execute {
  state "Acceptance criteria" as acceptance
  state "Test strategy + level\nminimal / focused / regression / full" as strategy
  state "Behavior change?" as behavior
  state "Test first\nwhen meaningful" as test_first
  state "Minimal change" as implement
  state "Focused validation\n[test-workflow]" as tests
  state "Fix / Refactor" as fix
  state "Slice complete" as complete

  acceptance --> strategy
  strategy --> behavior
  behavior --> test_first : yes
  behavior --> implement : no
  test_first --> implement
  implement --> tests
  tests --> complete : pass / stop
  tests --> fix : fail
  fix --> tests
}

state "More slices?" as more #FFF4CC
state "Integration / regression tests\n[test-workflow]" as integration
state "Independent reviewer?\n(optional)" as review_delegate #FFF4CC
state "Reviewer\n[.codex/agents/reviewer.toml]\nread-only findings" as reviewer_agent
state "Self review\n[codex review]" as review
state "Blocking problem?" as blocking #FFF4CC
state "Re-plan / Fix" as replan
state "State / Docs\n[repo-current-state]" as state_docs
state "Classify outputs" as classify_outputs
state "Potentially sensitive?" as sensitive #FFF4CC
state "Redaction\n[data-document-redaction]" as redaction
state "Redaction pass?" as redaction_gate #FFF4CC
state "Commit / Push\n[github-push-when-ready]" as publish
state "Automatic Deployment\n[auto-deploy]" as deployment
state "Health /\nSmoke Verification" as deploy_verify
state "Rollback /\nEscalate" as rollback #FDECEC
state "Blocked" as blocked #FDECEC

[*] --> requirement
requirement --> classify
classify --> context
context --> plan
plan --> slice
slice --> persist
persist --> delegation
delegation --> execute : no / sequential
delegation --> explorer : yes / independent
delegation --> workers
explorer --> worker_result
workers --> worker_result
worker_result --> more
execute --> more
more --> slice : yes
more --> integration : no
integration --> review_delegate
review_delegate --> reviewer_agent : yes / useful
review_delegate --> review : no / skip
reviewer_agent --> review
review --> blocking
blocking --> replan : problem
blocking --> state_docs : pass
replan --> plan : design / scope issue
replan --> integration : local fix
state_docs --> classify_outputs
classify_outputs --> sensitive
sensitive --> redaction : yes
sensitive --> publish : no
redaction --> redaction_gate
redaction_gate --> publish : pass
redaction_gate --> blocked : needs_review / blocked
publish --> deployment : requested
publish --> [*] : no deployment
deployment --> deploy_verify
deploy_verify --> [*] : pass
deploy_verify --> rollback : fail / timeout
rollback --> [*] : recovered / blocked

note right of execute
TDD is a conditional test strategy inside a Slice.
Use the smallest verification set that gives enough evidence.
Stop after the selected level passes unless escalation is justified.
end note

note right of delegation
The main agent owns requirements,
architecture, dependency ordering,
integration, and final judgment.
Keep dependent, overlapping, or shared-interface work sequential.
end note

note right of state_docs
Repo_Current_State.md is the compact recovery point
for current focus, verified behavior, failures, and next Slice.
Ticket detail and progress remain in GitHub Issues.
end note

note left of requirement
Delegation is optional, not automatic.
Prefer one delegation level.
Workers return findings, changes,
tests, and unresolved risks—not raw logs.
end note

@enduml
