@startuml
!theme plain
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam ArrowColor #4A5568
skinparam state {
  BackgroundColor #F8F9FA
  BorderColor #4A5568
  FontColor #1A202C
}

title Codex Development Workflow - Development Process

state "Context\n[context-efficiency]\nunderstand architecture, constraints,\nand existing behavior" as context
state "Plan / Ticket\n[plan-to-ticket]\ncreate dependency-ordered work\nand acceptance criteria" as plan
state "Implement\nCodex / target repository\nchange one ticket only" as implement
state "Run relevant\nproject tests / relevant test skill" as tests
state "Tests pass?" as tests_gate #FFF4CC
state "Frontend interaction changed?" as frontend_gate #FFF4CC
state "Real-browser click test\n[frontend-click-test]\nChromium" as browser
state "Code review gate\n[code-review]" as review
state "Blocking review finding?" as review_gate #FFF4CC
state "Repo State / Docs\n[repo-current-state]\nreconcile after verification" as repo_state
state "Classify outputs\nbefore staging or commit\ninclude files, names, metadata" as classify
state "Potentially sensitive?" as sensitive_gate #FFF4CC
state "Redaction gate\n[data-document-redaction]\ndetect -> minimum transform\n-> hidden-surface/utility verify\n-> safe report" as redaction
state "Redaction report pass?" as redaction_gate #FFF4CC
state "Commit / Push\n[github-push-when-ready]\ncommit one functional unit\nand publish after readiness" as publish
state "Blocked\nrecord the concrete blocker" as blocked #FDECEC

[*] --> context
context --> plan
plan --> implement
implement --> tests
tests --> tests_gate
tests_gate --> frontend_gate : yes
tests_gate --> implement : no / fix and retest
tests_gate --> blocked : no / blocker remains
frontend_gate --> browser : yes
frontend_gate --> review : no
browser --> review
review --> review_gate
review_gate --> repo_state : no / clear
review_gate --> implement : yes / fix, retest, review again
repo_state --> classify
classify --> sensitive_gate
sensitive_gate --> redaction : yes
sensitive_gate --> publish : no / record scope and skip reason
redaction --> redaction_gate
redaction_gate --> publish : yes / pass
redaction_gate --> blocked : no / needs_review or blocked
publish --> [*]

context -[hidden]down-> plan
plan -[hidden]down-> implement
implement -[hidden]down-> tests
tests -[hidden]down-> tests_gate
tests_gate -[hidden]down-> frontend_gate
frontend_gate -[hidden]down-> review
review -[hidden]down-> review_gate
review_gate -[hidden]down-> repo_state
repo_state -[hidden]down-> classify
classify -[hidden]down-> sensitive_gate
sensitive_gate -[hidden]down-> redaction
redaction -[hidden]down-> redaction_gate
redaction -[hidden]down-> publish

note right of frontend_gate
Browser verification is conditional;
backend-only and documentation-only changes
can continue directly to review.
end note

note right of sensitive_gate
Classify the complete change set before
staging or commit. Re-check before any
separate sharing or publication boundary.
end note

note right of redaction_gate
Only pass advances. Needs review or
blocked stops the boundary transition.
end note

note left of context
Orchestrated by
codex-development-workflow
end note

@enduml
