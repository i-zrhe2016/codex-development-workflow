@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam ArrowColor #4A5568
skinparam activityBackgroundColor #F8F9FA
skinparam activityBorderColor #4A5568
skinparam activityFontColor #1A202C

title repo-documentation — one fact, one owner, one diagram

start

:Documentation impact check\n(7 questions, one per change);

if (Change touches documented behavior\nor an existing diagram?) then (yes)
  :Find the canonical owner\nby document type;
  if (An owner document\nalready holds the fact?) then (yes)
    :Update the owner document;
  else (no)
    :Create the document\nonly when no owner exists;
  endif
  :Update the documentation router\n(root README.md) in the same change;
  if (Fact is a flow, sequence,\nlifecycle, or relationship set?) then (yes)
    :Write the .puml source in the\ndocument's diagrams/ directory;
    :Render and validate the image\n[AGENTS.md routes the renderer];
    :Embed the image with alt text\nand link the .puml source;
  else (no)
    :Keep the fact in prose;
  endif
  :Record the result in the\nchange's delivery record;
else (no)
  :Report that no documentation\nchange is needed;
endif

stop

@enduml
