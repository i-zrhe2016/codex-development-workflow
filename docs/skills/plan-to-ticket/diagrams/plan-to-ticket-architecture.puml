@startuml
!theme plain
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle

title plan-to-ticket — From Requirement to Authoritative Plan / Ticket Records

actor "Requestor" as requestor

package "plan-to-ticket" {
  component "Plan boundary" as plan
  component "Ticket decomposition" as tickets
  component "Slice decomposition" as slices
  component "Issue persistence\nwhen triggered" as persistence
  component "Result summary\nlinks + execution metadata" as output
}

database "GitHub Issues\nAuthoritative Plan / Ticket records" as issues

requestor --> plan : Provide requirement
plan --> tickets : Split behavior boundaries
tickets --> slices : Define dependency-ordered work
slices --> persistence : Supply executable Slice contracts
persistence --> issues : Create / update Plan + Ticket Issues
issues --> persistence : Return canonical IDs + URLs
persistence --> output : Assemble execution metadata
output --> requestor : Return persisted plan summary
@enduml
