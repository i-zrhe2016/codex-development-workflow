@startuml
!theme plain
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle

title plan-to-ticket — Plan / Ticket / Slice Persistence

actor "Requestor" as requestor
component "Skill trigger" as trigger
component "Plan boundary" as plan
component "Ticket decomposition" as tickets
component "Slice decomposition" as slices
component "Issue persistence\nrequired" as persistence
database "GitHub Issues\nauthoritative Plan / Ticket records" as issues
component "Result summary\nlinks + execution metadata" as output

folder "Skill bundle" as bundle {
  artifact "SKILL.md" as skill
  artifact "agents/openai.yaml" as metadata
}
folder "Documentation" as docs

requestor --> trigger : requirement
trigger --> plan
plan --> tickets : behavior boundaries
tickets --> slices : dependency-ordered work
slices --> persistence : complete execution contract
persistence --> issues : create / update Plan + Tickets
issues --> persistence : IDs / URLs
persistence --> output : canonical links
output --> requestor

skill --> trigger : invocation rules
skill --> plan : decomposition rules
metadata --> trigger : UI metadata
docs ..> requestor : usage / architecture reference
@enduml
