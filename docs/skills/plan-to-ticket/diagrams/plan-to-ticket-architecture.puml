@startuml
!theme plain
left to right direction

skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial

title Plan-to-Ticket Skill - Logical Architecture

actor "Requestor" as requestor

package "Codex orchestration" as orchestration #EAF2F8 {
  component "Skill matcher" as matcher #D6EAF8
  component "Planning instructions" as planner #D6EAF8
  component "Ticket decomposition" as ticketing #D6EAF8
  component "Slice decomposition" as slicing #D6EAF8
  component "Issue persistence\n(required)" as persistence #D6EAF8
  component "Text output\n(links only)" as output #D6EAF8
}

database "GitHub Issues\n(authoritative)" as issues #F9E79F

package "Repository assets" as repository #FDF2E9 {
  artifact "SKILL.md" as skill #FAD7A0
  artifact "agents/openai.yaml" as metadata #FAD7A0
  folder "docs/" as docs #FAD7A0
}

requestor --> matcher : request
matcher --> planner : select
planner --> ticketing : define behavior boundaries
ticketing --> slicing : split each Ticket
slicing --> persistence : persist Ticket plan
persistence --> issues : CRUD
issues --> persistence : IDs / URLs
persistence --> output : links
output --> requestor : Plan + Tickets

skill --> matcher : trigger
skill --> planner : rules
skill ..> persistence
metadata --> matcher
docs ..> requestor : reference

@enduml
