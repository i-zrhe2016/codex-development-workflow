@startuml
!theme plain
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle

title plan-to-ticket — Requirement / Plan / Ticket Persistence

actor "Requestor" as requestor
component "Skill trigger" as trigger
component "Plan boundary" as plan
component "Ticket decomposition\none Ticket or behavior Tickets" as tickets
component "Markdown Plan persistence\nfor new requirements" as persistence
database "One versioned Plan Markdown record\nPlan + indexed Ticket sections" as records
component "Result summary\nlinks + execution metadata" as output

folder "Skill bundle" as bundle {
  artifact "SKILL.md" as skill
  artifact "agents/openai.yaml" as metadata
}
folder "Documentation" as docs

requestor --> trigger : requirement
trigger --> plan
plan --> tickets : ordinary or complex scope
tickets --> persistence : complete Plan + Ticket records
persistence --> records : save / read back one file + sections
records --> persistence : IDs / paths
persistence --> output : canonical links
output --> requestor

skill --> trigger : invocation rules
skill --> plan : decomposition rules
metadata --> trigger : UI metadata
docs ..> requestor : usage / architecture reference
@enduml
