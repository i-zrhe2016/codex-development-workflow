@startuml
!theme plain
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle
title Codex Development Capabilities — Model-Selected Capabilities
actor "User" as user
component "Model reasoning\nIntent · architecture · implementation · coordination" as model
component "codex-development-workflow\nThin policy / compatibility" as policy
component "plan-to-ticket\nPersisted planning" as plan
component "test-quality\nVerification evidence\nTest Quality Gate" as test
component "repo-documentation\nDocumentation governance" as docs
component "repo-current-state\nVerified state snapshot" as state
component "data-document-redaction\nStaged sensitive-data scan" as redact
component "github-publish\nCommit / Push / PR guard" as publish
component "plantuml\nDiagram capability" as diagram
database "GitHub Issues" as issues
cloud "GitHub" as github
folder "Repository" as repository
user --> model : goal
model --> policy : guardrails
model --> plan : complex / resumable
plan --> issues : persist
model --> test : verification needed
model --> docs : documentation affected
model --> state : verified truth changed
model --> redact : sensitive staged surface
model --> publish : commit / push / PR
publish --> github
model --> diagram : visual explanation useful
docs --> repository
state --> repository
diagram --> repository
@enduml
