@startuml
!theme plain
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
title Capability-Driven Development — No Fixed Stage Workflow
state "User goal" as Goal
state "Model reasons about current objective" as Reason
state "Native work\nplan · inspect · implement · integrate" as Native
state "Capability trigger applies?" as Trigger
state "Load smallest matching capability" as Capability
state "Execute specialized contract / gate" as Execute
state "Requested outcome satisfied?" as Done
[*] --> Goal
Goal --> Reason
Reason --> Native
Reason --> Trigger
Trigger --> Capability : yes
Trigger --> Done : no capability needed
Capability --> Execute
Execute --> Reason : continue goal
Native --> Done
Done --> Reason : no
Done --> [*] : yes
@enduml
