@startuml
!theme plain
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial

title Codex Development Workflow — Full Orchestration, Requirement to Delivery

state "Requirement" as Requirement
state "plan-workflow\nUnderstand · Design · Decompose" as Understand
state "Plan" as Plan
state "Persist Plan + Tickets + Slices\nGitHub Issues (when required)" as Issues
state "Create Plan branch" as Branch
state "develop-workflow\nImplement all Plan Tickets" as Implement
state "verify-workflow\nTest Quality Gate" as Test
state "Documentation impact check" as Docs
state "Redaction scan\nwhen applicable" as Redact
state "Commit + Push branch" as Publish
state "Create / Update Plan PR" as PR
state "integrate-workflow\nMerge Plan PR once" as Merge
state "Delete branch + Update main" as Cleanup
state "Close Plan + Tickets" as Close
state "Update State / Docs" as State
state "Evaluate workflow" as Evaluate
state "Bounded follow-up improvement" as Improve

[*] --> Requirement
Requirement --> Understand
Understand --> Plan
Plan --> Issues : persist when required
Issues --> Branch
Branch --> Implement
Implement --> Test
Test --> Implement : BLOCKED / failed evidence
Test --> Docs : PASS
Docs --> Redact
Redact --> Publish
Publish --> PR
PR --> Merge
Merge --> Cleanup
Cleanup --> Close
Close --> State
State --> Evaluate
Evaluate --> Improve : reusable low-risk improvement
Improve --> [*] : run through the same workflow
Evaluate --> [*] : no improvement
@enduml
