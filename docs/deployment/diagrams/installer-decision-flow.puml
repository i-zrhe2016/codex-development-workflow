@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
title install-all.sh — Capability Installation and Safe Retirement
start
:Resolve Codex / Claude destination;
if (Destination inside repository?) then (yes)
  :Refuse installation;
  stop
endif
:For each of 8 managed bundles;
if (Destination exists?) then (no)
  :Install capability;
else (yes)
  if (Update enabled?) then (yes)
    if (Managed ownership marker matches?) then (yes)
      :Replace managed bundle;
    else (no)
      :Preserve or adopt legacy when explicitly requested;
    endif
  else (no)
    :Skip existing bundle;
  endif
endif
if (Update enabled?) then (yes)
  :Remove owned retired stage Skills\nand renamed legacy capability destinations;
endif
:Report installed / skipped / migrated;
stop
@enduml
