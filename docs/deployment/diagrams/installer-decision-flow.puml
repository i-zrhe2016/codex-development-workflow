@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial

title install-all.sh — Destination, Ownership, Update and Retirement

start
:Parse target / dest / update / adopt-legacy options;

if (Adopt legacy enabled without update?) then (yes)
  :Refuse invalid option combination;
  stop
endif

if (Explicit dest provided?) then (yes)
  :Use explicit skills destination;
else (no)
  :Resolve target default\nCodex: CODEX_HOME or HOME/.codex/skills\nClaude: HOME/.claude/skills;
endif

if (Destination is inside repository?) then (yes)
  :Refuse installation;
  stop
endif

if (Update enabled?) then (yes)
  while (More retired skill destinations?) is (yes)
    :Select next retired destination\nincluding context-efficiency and prior retired bundles;
    if (Retired destination exists?) then (yes)
      if (Ownership marker matches retired name?) then (yes)
        :Remove owned retired destination;
      else (no)
        if (Adopt legacy enabled?) then (yes)
          :Move retired destination into recoverable backup directory;
        else (no)
          :Preserve retired destination\nReport ownership unverified;
        endif
      endif
    endif
  endwhile (no)
endif

:For each of 13 managed bundles;

if (Destination exists?) then (no)
  :Copy bundle;
  :Write ownership marker;
else (yes)
  if (Update enabled?) then (no)
    :Skip existing bundle;
  else (yes)
    if (Ownership marker matches?) then (yes)
      :Replace managed bundle;
    else (no)
      if (Adopt legacy enabled?) then (yes)
        :Move legacy bundle to recoverable backup;
        :Install managed bundle;
      else (no)
        :Preserve path\nReport ownership unverified;
      endif
    endif
  endif
endif

:Report installed / skipped / migrated\nand resolved destination;
stop
@enduml
